# Initial operator profile map. install.sh copies this file once to
# ~/.config/ghost-operator/config.env and never overwrites the local copy.
# Paths only: credentials remain inside the provider-owned directories.

CLAUDE_COMMAND="claude"
CLAUDE_PROFILE_DEFAULT="$HOME/.claude"
CLAUDE_PROFILE_1="$HOME/.claude-1"
CLAUDE_PROFILE_2="$HOME/.claude-2"
CLAUDE_PROFILE_3="$HOME/.claude-3"
CLAUDE_PROFILE_4="$HOME/.claude-4"

CODEX_COMMAND="codex"
CODEX_PROFILE_DEFAULT="$HOME/.codex"
CODEX_PROFILE_1="$HOME/.codex"
CODEX_PROFILE_2="$HOME/.codex-2"
CODEX_PROFILE_3="$HOME/.codex-3"

# Antigravity's `agy` wrapper owns its slot isolation; the portable launcher
# passes 1 or 2 as the first argument and stores no browser/account state.
ANTIGRAVITY_COMMAND="agy"
ANTIGRAVITY_SLOT_1="1"
ANTIGRAVITY_SLOT_2="2"

GHOST_WORKTREE_ROOT="/data/worktrees"
GHOST_WORKTREE_FALLBACK_ROOT="$HOME/worktrees"
GHOST_WORKTREE_MAX_USED_PCT="94"
