# Personal overlay — example.
#
# This overlay wires portable launchers without embedding provider credentials
# or machine-private profile contents. `install.sh` links the commands below to
# ~/.local/bin. Profile state remains in each provider's own config directory.
#
# Usage:
#   cp personal.conf.example personal.conf
#   # edit to point at YOUR scripts
#   # then in hyprland.conf:  source = ~/.config/hypr/personal.conf

# --- Launch my desktop overlay at login ---
# exec-once = ~/path/to/your/desktop-overlay

# --- Middle mouse: close whitelisted apps, SUPER+middle: region-snip → OCR → clipboard ---
# bind = ,         mouse:274, exec, ~/.local/bin/mmb-close
# bind = $mainMod, mouse:274, exec, ~/.local/bin/region-snip

# --- Mouse side buttons → separately authenticated Claude seats ---
# Plain side buttons open fresh tmux sessions in the current default project.
# Add a directory as the final argument when a binding belongs to one project.
bind = , mouse:276, exec, ~/.local/bin/spawn-agent-session claude 1
bind = , mouse:275, exec, ~/.local/bin/spawn-agent-session claude 2

# Shift replaces the currently focused terminal with another seat.
bind = SHIFT, mouse:276, exec, hyprctl dispatch killactive && ~/.local/bin/spawn-agent-session claude 1
bind = SHIFT, mouse:275, exec, hyprctl dispatch killactive && ~/.local/bin/spawn-agent-session claude 2

# Example: create a unique worktree and open seat 4 inside it. Keep the base
# explicit so a stale local main is never selected accidentally.
# bind = CTRL, mouse:276, exec, ~/.local/bin/new-agent-worktree claude 4 origin/main mouse-lane

# --- Batch screenshot collector (appends regions, builds a context bundle) ---
# bind = CTRL SHIFT ALT, S, exec, ~/.local/bin/shot-collect
# bind = CTRL SHIFT ALT, R, exec, ~/.local/bin/shot-collect --reset

# --- Push-to-talk voice input (whisper) ---
# bind = SUPER, Space, exec, ~/.local/bin/voice-ptt
